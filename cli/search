#!/usr/bin/env python3
"""search - hybrid search across the indexed voice corpus.

Dense (embeddings) and lexical (BM25) legs run together and are fused by
rank, so an idea phrased differently and a proper noun spelled exactly both
come back. Filters apply to both legs.

Usage:
    search "terraform deploying sentry"
    search -k 50 "everything I said about onboarding flows"
    search --multi "how I explain my dev setup"      # LLM query variations + rank fusion
    search --human "pricing"                          # only rows written to people
    search --kind status --kind ask "deploy"          # by message kind
    search --lang fr "réunion"                        # by detected language
    search --source whatsapp "pickup"                 # by origin (wispr, whatsapp, gmail)
    search --ctx team_chat "discord notifications"    # restrict to one context
    search --since 2026-03-01 "azure key vault"       # restrict by date
    search --min-words 25 "why I moved to a cloud VM" # longer rows only
    search --recency 1 "what I'm working on"          # favour recent rows
    search --json "..."                               # machine-readable output

Near-duplicate dictations are collapsed by default; --no-dedup shows all.
--no-lexical runs the dense leg alone.
"""

import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

import corpus  # noqa: E402  (loads .env)
import retrieval  # noqa: E402


def query_variations(query: str, n: int):
    """Ask the configured LLM for n-1 paraphrases; the original is always first."""
    try:
        import llm
        prompt = (
            "Rewrite the following search query {n} different ways for semantic "
            "search over a corpus of spoken, dictated notes. Keep each variation "
            "short, conversational, and focused on the same topic. Return one "
            "variation per line, no numbering, nothing else.\n\nQuery: {q}"
        ).format(n=n - 1, q=query)
        out = llm.generate([{"role": "user", "content": prompt}], max_tokens=300, temperature=0.7)
        text = out[0] if isinstance(out, tuple) else out
        variations = [v.strip() for v in text.splitlines() if v.strip()]
        return [query] + variations[: n - 1]
    except Exception as e:  # LLM offline, no keys, etc. Search still works.
        sys.stderr.write(f"[multi] LLM unavailable ({e}); using the original query only\n")
        return [query]


def main():
    ap = argparse.ArgumentParser(prog="search", description="Hybrid search across the voice corpus")
    ap.add_argument("query", help="Natural-language query")
    ap.add_argument("-k", "--top", type=int, default=100, help="Number of results (default 100)")
    ap.add_argument("--multi", nargs="?", const=4, type=int, metavar="N",
                    help="Run N query variations (LLM paraphrases) and fuse rankings (default N=4)")
    ap.add_argument("--no-dedup", action="store_true", help="Keep near-duplicate dictations")
    ap.add_argument("--no-lexical", action="store_true", help="Dense leg only")
    ap.add_argument("--human", action="store_true", help="Only rows written to people")
    ap.add_argument("--kind", action="append", metavar="KIND",
                    help=f"Message kind, repeatable ({', '.join(corpus.KINDS)})")
    ap.add_argument("--lang", action="append", metavar="LANG", help="Detected language, repeatable (en, fr, ro)")
    ap.add_argument("--source", action="append", metavar="SRC", help="Origin, repeatable (wispr, whatsapp, gmail)")
    ap.add_argument("--ctx", help="Restrict to one context (ai_chat, team_chat, personal_chat, browser, email, other)")
    ap.add_argument("--min-words", type=int, help="Only rows with at least N words")
    ap.add_argument("--since", help="Earliest date (YYYY-MM-DD)")
    ap.add_argument("--until", help="Latest date (YYYY-MM-DD)")
    ap.add_argument("--recency", type=float, default=0.0,
                    help="Weight of a recency boost, 0 = off, 1 = a fresh row outranks a year-old twin")
    ap.add_argument("--width", type=int, default=180, help="Truncate text at N chars in pretty mode")
    ap.add_argument("--json", action="store_true", help="Emit JSON instead of pretty rows")
    args = ap.parse_args()

    variations = None
    if args.multi and args.multi > 1:
        queries = query_variations(args.query, args.multi)
        if len(queries) > 1:
            sys.stderr.write("[multi] querying with:\n")
            for q in queries:
                sys.stderr.write(f"  - {q}\n")
            variations = queries[1:]

    rows = retrieval.search(
        args.query, k=args.top, queries=variations,
        human=True if args.human else None, lang=args.lang, kinds=args.kind, ctx=args.ctx,
        sources=args.source, min_words=args.min_words, since=args.since, until=args.until,
        lexical=not args.no_lexical, dedup=not args.no_dedup, recency=args.recency,
    )

    if args.json:
        out = [{"id": r["id"], "sim": round(r["sim"], 4), "score": round(r["score"], 5), "sources": r["sources"],
                "ts": r["meta"].get("ts", ""), "ctx": r["meta"].get("ctx", ""), "kind": r["meta"].get("kind", ""),
                "human": r["meta"].get("human", False), "lang": r["meta"].get("lang", ""),
                "source": r["meta"].get("source", ""), "n_words": r["meta"].get("n_words", 0), "text": r["text"]}
               for r in rows]
        print(json.dumps({"query": args.query, "k": args.top, "results": out}, ensure_ascii=False, indent=2))
        return

    print(f"Top {len(rows)} rows for: {args.query!r}")
    print("=" * 80)
    for i, r in enumerate(rows, 1):
        meta = r["meta"]
        ts = (meta.get("ts") or "")[:10]
        legs = "".join(s[0] for s in r["sources"])  # d, l, or dl
        who = "H" if meta.get("human") else " "
        text = (r["text"] or "").replace("\n", " ")
        if len(text) > args.width:
            text = text[: args.width - 1] + "…"
        print(f"{i:3d}. [sim={r['sim']:.3f} {legs:2s} {who}] {ts} {meta.get('ctx', ''):13s} "
              f"{meta.get('kind', ''):11s} {text}")


if __name__ == "__main__":
    main()
